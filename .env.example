# Zoho Catalyst QuickML Configuration
# Set the published endpoint URL provided by Zoho Catalyst QuickML console
QUICKML_ENDPOINT_URL=

# Optional Bearer Token or API Key for Zoho QuickML endpoint authentication
QUICKML_AUTH_TOKEN=

# Request timeout in seconds for QuickML calls
QUICKML_TIMEOUT_SECONDS=10

# In local/offline mode, set to 1 to allow the labelled local fallback model
# In production, set to 0: requests will explicitly fail if QuickML is unconfigured or unreachable
ALLOW_DEV_LOCAL_BASELINE=1

# Server port
PORT=8000
